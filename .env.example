# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon Postgres connection string.
# Get one free at https://neon.tech -> create a project -> copy the pooled
# connection string. Format:
#   postgresql://user:pass@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# When set, waitlist signups are stored in Neon Postgres and the
# waitlist_signups table is created/migrated automatically on server boot.
# When empty, the server falls back to a local data/waitlist.json file so the
# site still works in development.
# Put the real value in .env (git-ignored), never in this file.
DATABASE_URL=
